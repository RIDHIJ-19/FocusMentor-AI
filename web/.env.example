# Copy this file to "web/.env" and fill in the values below (for local dev
# only -- on Render these are set as real environment variables instead,
# see USAGE.md's "Deploying to Render" section).

# Required: a Neon (neon.tech) Postgres connection string, free tier.
# Neon dashboard -> your project -> Connection string (use the "pooled"
# one). Looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Optional: same free key from console.groq.com used by the desktop app.
# Without it, AI features fall back to free offline logic.
GROQ_API_KEY=
